# =============================================================================
# 水下目标智能检测平台 - 环境变量配置模板
# =============================================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际环境修改配置值
# 3. 不要将 .env 文件提交到版本控制系统
# =============================================================================

# -----------------------------------------------------------------------------
# 应用配置
# -----------------------------------------------------------------------------
PROJECT_NAME="Water Target Detection API"
VERSION="1.0.0"
DESCRIPTION="企业级水下目标智能检测平台"
API_V1_STR="/api/v1"

# -----------------------------------------------------------------------------
# 数据库配置
# -----------------------------------------------------------------------------
# SQLite (开发环境)
# DATABASE_URL="sqlite+aiosqlite:///./water_detection.db"

# PostgreSQL (生产环境 - 推荐)
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/water_detection"

# 数据库连接池配置 (仅 PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=false  # 生产环境设为 false

# -----------------------------------------------------------------------------
# Redis 配置
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# -----------------------------------------------------------------------------
# Celery 配置
# -----------------------------------------------------------------------------
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600  # 1小时任务超时
CELERY_RESULT_EXPIRES=86400  # 结果保留24小时

# -----------------------------------------------------------------------------
# JWT 认证配置
# -----------------------------------------------------------------------------
# 重要：生产环境必须更改为强随机密钥！
# 生成方法: openssl rand -hex 32
SECRET_KEY="your_secret_key_here_please_change_me_in_production_use_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# 文件上传配置
# -----------------------------------------------------------------------------
UPLOAD_DIR="uploads"
RESULT_DIR="results"
MODEL_DIR="models"
MAX_UPLOAD_SIZE=524288000  # 500MB (字节)

# -----------------------------------------------------------------------------
# 检测配置
# -----------------------------------------------------------------------------
DETECTION_INPUT_DIR="uploads/detections/input"
DETECTION_OUTPUT_DIR="uploads/detections/output"
MAX_IMAGE_SIZE=10485760  # 10MB
MAX_VIDEO_SIZE=209715200  # 200MB
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45

# 支持的文件格式（逗号分隔）
SUPPORTED_IMAGE_FORMATS=".jpg,.jpeg,.png,.bmp,.webp"
SUPPORTED_VIDEO_FORMATS=".mp4,.avi,.mov,.mkv"

# -----------------------------------------------------------------------------
# CORS 配置
# -----------------------------------------------------------------------------
# 允许的前端源（逗号分隔）
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://yourdomain.com"

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# 生产环境额外配置
# -----------------------------------------------------------------------------
# 是否启用生产模式
PRODUCTION=false

# Sentry 错误追踪 (可选)
# SENTRY_DSN=""

# -----------------------------------------------------------------------------
# 注意事项
# -----------------------------------------------------------------------------
# 1. SECRET_KEY 必须保密，不要泄露
# 2. 生产环境数据库密码要足够复杂
# 3. 确保 .env 文件在 .gitignore 中
# 4. 定期更换密钥和密码
# 5. 使用环境变量管理工具（如 Docker secrets）更安全
# =============================================================================
