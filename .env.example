# 项目配置
PROJECT_NAME=Water Target Detection API
API_V1_STR=/api/v1

# 数据库配置（开发环境使用 SQLite）
DATABASE_URL=sqlite:///./water_detection.db
# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/water_detection

# Redis配置（第三阶段需要，用于 Celery）
REDIS_URL=redis://localhost:6379/0

# JWT配置
SECRET_KEY=your_secret_key_here_please_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 文件配置
UPLOAD_DIR=uploads
RESULT_DIR=results
MODEL_DIR=models
MAX_UPLOAD_SIZE=524288000

# CORS配置
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 日志配置
LOG_LEVEL=INFO
